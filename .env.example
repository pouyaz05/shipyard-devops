# `make up` creates .env automatically with random values. This file only documents the variables.
# Never commit .env.

# Database superuser password (user is "shipyard")
POSTGRES_PASSWORD=change-me
# Shared by user-service (issues tokens) and cart/order-service (verify tokens). At least 32 characters.
JWT_SECRET=change-me-at-least-32-characters-long
# product-service write endpoints (temporary admin protection). At least 16 characters.
ADMIN_API_KEY=change-me-16-chars-min
# order-service -> product-service internal stock endpoints. At least 16 characters.
INTERNAL_API_KEY=change-me-16-chars-min

# Optional
GATEWAY_PORT=8080
# For restricted networks, point to a mirror:
PIP_INDEX_URL=https://pypi.org/simple
NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
